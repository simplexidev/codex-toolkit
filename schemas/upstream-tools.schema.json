{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "integrations",
    "policy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "policy",
          "purpose",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "policy": {
            "enum": [
              "required",
              "recommended",
              "optional",
              "on-demand"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policy": {
      "type": "string",
      "minLength": 1
    }
  }
}
