{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "repo-health",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requireNullable",
    "requireCentralPackages",
    "requireDeterministic",
    "requireAnalyzers",
    "requireLockFiles",
    "allowedFrameworks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "requireNullable": {
      "type": "boolean"
    },
    "requireCentralPackages": {
      "type": "boolean"
    },
    "requireDeterministic": {
      "type": "boolean"
    },
    "requireAnalyzers": {
      "type": "boolean"
    },
    "requireLockFiles": {
      "type": "boolean"
    },
    "allowedFrameworks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
