{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "repositories"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "revision",
          "status"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
