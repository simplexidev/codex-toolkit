{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "toolkit-config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "optionalTools",
    "enabledIntegrations",
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "optionalTools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "enabledIntegrations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  }
}
