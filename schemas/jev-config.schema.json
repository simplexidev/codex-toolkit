{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jev-config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "apiUrl",
    "model",
    "timeoutSeconds",
    "maxInputBytes",
    "maxCandidates",
    "includeThreshold",
    "excludeThreshold",
    "minConfidence",
    "cacheHours",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "auto",
        "off",
        "required"
      ]
    },
    "apiUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "maxInputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "maxCandidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "includeThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "excludeThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "minConfidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "cacheHours": {
      "type": "integer",
      "minimum": 0,
      "maximum": 720
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["allowed", "purposes", "expectedCalls", "maxCalls", "deterministicFirst", "maxInputBytes", "maxCandidates", "privacy", "minConfidence", "uncertainty", "gptEscalation"],
        "properties": {
          "allowed": { "type": "boolean" },
          "purposes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
          "expectedCalls": { "type": "integer", "minimum": 0, "maximum": 100 },
          "maxCalls": { "type": "integer", "minimum": 0, "maximum": 100 },
          "deterministicFirst": { "type": "boolean" },
          "maxInputBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
          "maxCandidates": { "type": "integer", "minimum": 0, "maximum": 100 },
          "privacy": { "type": "string", "minLength": 1 },
          "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "uncertainty": { "const": "review" },
          "gptEscalation": { "enum": ["normal", "stronger"] }
        }
      }
    }
  }
}
