{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "output-limits",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "maxLines",
    "maxLineLength",
    "maxItems",
    "maxOutputChars"
  ],
  "properties": {
    "maxOutputChars": {"type":"integer","minimum":1024,"maximum":131072},
    "$schema": {
      "type": "string"
    },
    "maxLines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "maxLineLength": {
      "type": "integer",
      "minimum": 20,
      "maximum": 2000
    },
    "maxItems": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  }
}
